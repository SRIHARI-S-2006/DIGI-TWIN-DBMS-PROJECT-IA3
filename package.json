{
  "name": "university-erp-enterprise-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise multi-university ERP backend with Node.js, TypeScript, Express, MongoDB, scoped RBAC/ABAC, workflow approvals and OpenAPI/Swagger.",
  "main": "dist/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/seed.ts",
    "docs:export": "tsx src/scripts/export-openapi.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run build && npm run test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "bcryptjs": "3.0.2",
    "compression": "1.8.1",
    "cors": "2.8.5",
    "dotenv": "16.5.0",
    "express": "5.1.0",
    "express-rate-limit": "7.5.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "^8.24.1",
    "pino": "9.7.0",
    "pino-http": "10.4.0",
    "swagger-ui-express": "5.0.1",
    "uuid": "^11.1.1",
    "zod": "3.25.28"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.2",
    "@types/jsonwebtoken": "9.0.9",
    "@types/node": "22.15.24",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "mongodb-memory-server": "10.1.4",
    "prettier": "3.5.3",
    "supertest": "7.1.1",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "^3.2.7"
  }
}
