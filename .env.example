NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/university_erp
JWT_ACCESS_SECRET=replace-with-at-least-32-characters-access-secret
JWT_REFRESH_SECRET=replace-with-at-least-32-characters-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=info
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
BOOTSTRAP_KEY=change-this-bootstrap-key
PLATFORM_NAME=UniSphere ERP
